{
  "name": "unibox",
  "short_name": "unibox",
  "description": "Dump anything, get it classified, and be nudged when it's a good moment.",
  "id": "/",
  "start_url": "/?screen=dump",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#161826",
  "theme_color": "#161826",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Dump something", "short_name": "Dump", "url": "/?screen=dump" },
    { "name": "Triage", "short_name": "Triage", "url": "/?screen=triage" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["image/*", "video/*", "audio/*", "application/pdf", "text/plain"] }
      ]
    }
  }
}
