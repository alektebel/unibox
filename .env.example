# NAN_API_KEY is read from your environment / ~/.bashrc; set it here only to override
# NAN_API_KEY=
MAILOS_DB=/path/to/mailos.db
LLM_MODEL=qwen3.6
# LLM_THINKING=1               # let qwen reason before answering (slower; off for triage)
# LLM_TIMEOUT_MS=90000
# UNIBOX_LANG=es                # language of task titles/reasons the model writes (es|en)

# Google — sign-in + Gmail + Calendar (read-only). See README → Google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_EMAIL=you@gmail.com   # only this account may sign in
# UNIBOX_GOOGLE_LOGIN=0               # keep Gmail/Calendar but don't gate the UI behind sign-in
# UNIBOX_PUBLIC_URL=http://localhost:8124   # fixes the OAuth redirect host; defaults to https://$UNIBOX_DOMAIN or the request host
# GMAIL_DAYS=14
# CALENDAR_DAYS=7

# Dump / nudges
UNIBOX_QUIET_START=22          # nudges never fire 22:00 → 08:00
UNIBOX_QUIET_END=8
UNIBOX_NUDGE_MINUTES=10        # how often the worker checks for a moment
UNIBOX_NUDGE_GAP=60            # at most one nudge per hour
UNIBOX_NUDGE_COOLDOWN=180      # don't re-nudge the same item for 3h
UNIBOX_SELFCHAT_NUDGES=1       # also send nudges into WhatsApp "Message yourself"
# UNIBOX_WHISPER_MODEL=whisper    # gateway audio transcription model

# Android / PWA
# UNIBOX_HOST=0.0.0.0          # 127.0.0.1 by default; 0.0.0.0 exposes on the LAN
# UNIBOX_TOKEN=long-random      # required when exposed; paste once as ?token=…
# UNIBOX_VAPID_SUBJECT=mailto:you@example.com   # Web Push contact; keys auto-generate

# Cloud deploy (docker compose)
# UNIBOX_DOMAIN=unibox.example.com   # Caddy gets a trusted HTTPS cert for this name
# UNIBOX_SELFCHAT_NUDGES=1           # send nudges into WhatsApp "Message yourself"

# You
# UNIBOX_ME_NAME=Your Name                 # how the assistant refers to you (first name is used in prompts)
# UNIBOX_ALWAYS_ALLOW=com.example.app       # apps that are never blocked, besides the built-in essentials
