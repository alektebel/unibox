<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Targeting SDK 35 forces edge-to-edge, which stops adjustResize from shrinking the
         WebView for the keyboard (inputs end up hidden behind it). Opt out for now. -->
    <style name="AppTheme.NoActionBar" parent="Base.AppTheme.NoActionBar">
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
